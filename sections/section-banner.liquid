{%- liquid
  assign section_st = section.settings
  
  capture section_styles
    echo '--sbg: ' | append: section_st.bg | append: ';'
    if section_st.bgg != blank
      echo '--sbg: ' | append: section_st.bgg | append: ';'
    endif
    echo '--sst: ' | append: section_st.sst | append: 'px;'
    echo '--ssb: ' | append: section_st.ssb | append: 'px;'
    echo '--sstm: ' | append: section_st.sstm | append: 'px;'
    echo '--ssbm: ' | append: section_st.ssbm | append: 'px;'
    echo '--rounded: ' | append: section_st.rounded | append: 'px;'
    echo '--blocks-gap: ' | append: section_st.blocks_gap | append: 'px;'
    
    assign overlay_alpha = section_st.overlay_op | divided_by: 100.0
    echo '--overlay: ' | append: section_st.overlay | color_modify: 'alpha', overlay_alpha | append: ';'
  endcapture
-%}

<section 
  class="banner-section banner-{{ section.id }} {% if section_st.hidem %} hide-sm{% endif %}{% if section_st.hided %} hide-md hide-lg{% endif %}"
  style="{{ section_styles }}"
>
  <div class="{% if section_st.sw %}container-fluid{% if section_st.npd %} p-0{% endif %}{% else %}container{% endif %}">
    
    {% if section_st.section_link != blank %}
      <a href="{{ section_st.section_link }}" class="section-overlay-link" aria-label="View collection"></a>
    {% endif %}

    <div class="banner-wrapper">
      {%- for block in section.blocks -%}
        {%- liquid 
          assign block_st = block.settings 
          capture block_id
            echo section.id | append: '-' | append: block.id
          endcapture
        -%}

        <div class="banner-block block-{{ block.id }} layout-{{ block_st.order }}" {{ block.shopify_attributes }}>
          
          {%- comment -%} Media Part {%- endcomment -%}
          <div class="banner-media" style="--m-radius: {{ section_st.media_radius }}; --m-radius-mb: {{ section_st.media_radius_mobile }};">
            {%- capture block_media -%}
              {%- if block_st.media_type == 'image' -%}
                {%- if block_st.image != blank -%}
                  {{ block_st.image | image_url: width: 1500 | image_tag: loading: 'lazy', class: 'media-fit', widths: '375, 550, 750, 1100, 1500' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

              {%- elsif block_st.media_type == 'video' -%}
                 <div class="video-container" style="--aspect-ratio: {{ block_st.video_aspect_ratio }}%;">
                  {%- if block_st.video_url contains 'youtube' or block_st.video_url contains 'vimeo' -%}
                    {%- if block_st.video_url contains 'youtube' -%}
                       <iframe src="https://www.youtube.com/embed/{{ block_st.video_url | split: 'v=' | last | split: '&' | first }}" frameborder="0" allowfullscreen></iframe>
                    {%- else -%}
                       <iframe src="https://player.vimeo.com/video/{{ block_st.video_url | split: '/' | last }}" frameborder="0" allowfullscreen></iframe>
                    {%- endif -%}
                  {%- else -%}
                    <video playsinline controls preload="metadata" poster="{{ block_st.image | image_url: width: 800 }}">
                      <source src="{{ block_st.video_url }}" type="video/mp4">
                    </video>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endcapture -%}
            {{ block_media }}
          </div>

          {%- comment -%} Content Part {%- endcomment -%}
          <div class="banner-content text-{{ block_st.text_align }}" 
               style="--c-padding: {{ block_st.content_padding }}px; --c-padding-mb: {{ block_st.content_padding_mobile }}px;">
            
            {% if block_st.subheading != blank %}
              <div class="subheading">{{ block_st.subheading }}</div>
            {% endif %}
            
            {% if block_st.heading != blank %}
              <div class="heading h2">{{ block_st.heading }}</div>
            {% endif %}
            
            {% if block_st.text != blank %}
              <div class="description">{{ block_st.text }}</div>
            {% endif %}

            {% if block_st.btntxt != blank %}
              <div class="banner-actions">
                <a href="{{ block_st.url }}" 
                   class="button {{ block_st.btn_style }} {{ block_st.btn_size }}"
                   {% if block_st.newtab %}target="_blank"{% endif %}>
                  {{ block_st.btntxt }}
                </a>
              </div>
            {% endif %}
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.banner-{{ section.id }} {
  background: var(--sbg);
  padding-top: var(--sst);
  padding-bottom: var(--ssb);
  position: relative;
  overflow: hidden;
}

.banner-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--blocks-gap);
  border-radius: var(--rounded);
}

.banner-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  min-height: 400px;
}

.banner-block.layout-text { grid-template-areas: "content media"; }
.banner-block.layout-image { grid-template-areas: "media content"; }

.banner-media { grid-area: media; position: relative; overflow: hidden; border-radius: var(--m-radius); height: 100%; width: 100%; }
.banner-content { grid-area: content; padding: var(--c-padding); }

.media-fit { width: 100%; height: 100%; object-fit: cover; }

/* Fancy Typography */
.banner-{{ section.id }} .heading em {
  {% if section_st.italic_fancy_font %}
    font-style: italic;
    {% case section_st.italic_font_selection %}
      {% when 'primary' %} font-family: var(--font-body-family);
      {% when 'alternative' %} font-family: var(--font-heading-family);
    {% endcase %}
    {% if section_st.italic_outline %}
      -webkit-text-stroke: 1px currentColor;
      -webkit-text-fill-color: transparent;
    {% endif %}
  {% endif %}
}

.video-container { position: relative; width: 100%; padding-bottom: var(--aspect-ratio); }
.video-container iframe, .video-container video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }

.section-overlay-link { position: absolute; inset: 0; z-index: 5; }

@media (max-width: 768px) {
  .banner-{{ section.id }} { padding-top: var(--sstm); padding-bottom: var(--ssbm); }
  .banner-block { grid-template-columns: 1fr; grid-template-areas: "media" "content" !important; min-height: auto; }
  .banner-media { border-radius: var(--m-radius-mb); height: 300px; }
  .banner-content { padding: var(--c-padding-mb); }
  .hide-sm { display: none !important; }
}
</style>