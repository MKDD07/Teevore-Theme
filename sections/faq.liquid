{% liquid
  assign section_st = section.settings
  assign is_women_template = false
  if request.path contains '/collections/women' or template contains 'girls_collections'
    assign is_women_template = true
  endif
%}

<div 
  class="faq-section sec_cov{% if section_st.hidem %} hide-sm{% endif %}{% if section_st.hided %} hide-md hide-lg{% endif %}{% if section_st.bgimg != blank %} has-bg-img{% endif %}"
  style="
    --section-bg: {% if is_women_template %}#f1f1f1{% elsif section_st.bgg != blank %}{{ section_st.bgg }}{% else %}{{ section_st.bg }}{% endif %};
    --section-spacing-top: {{ section_st.sst }}px;
    --section-spacing-bottom: {{ section_st.ssb }}px;
    --section-spacing-top-mobile: {{ section_st.sstm }}px;
    --section-spacing-bottom-mobile: {{ section_st.ssbm }}px;
    --overlay-color: {{ section_st.overlay | color_modify: 'alpha', section_st.overlay_op }};
    --title-color: {% if is_women_template %}#222{% else %}{{ section_st.tcl }}{% endif %};
    --question-color: {% if is_women_template %}#222{% else %}{{ section_st.qu }}{% endif %};
    --answer-color: {% if is_women_template %}#222{% else %}{{ section_st.an }}{% endif %};
    --border-color: {% if is_women_template %}#d9d9d9{% else %}{{ section_st.bdr }}{% endif %};
    --question-font-size: {{ section_st.fs }}px;
    --question-font-size-mobile: {{ section_st.fsm }}px;
    --answer-font-size: {{ section_st.fst }}px;
    --answer-font-size-mobile: {{ section_st.fsmt }}px;
    --faq-max-width: {{ section_st.page_width }}px;
  "
  {% if section_st.bgimg != blank %}
    data-bg-image="{{ section_st.bgimg | image_url: width: 2400 }}"
  {% endif %}
>
  <div class="{% if section_st.sw %}container-fluid{% else %}page-width{% endif %}">
    
    {%- comment -%} Section Header {%- endcomment -%}
    {% if section_st.title != blank or section_st.subtitle != blank %}
      <div class="faq-header text-center">
        {% if section_st.title != blank %}
          <h2 class="faq-main-title">{{ section_st.title }}</h2>
        {% endif %}
        {% if section_st.subtitle != blank %}
          <div class="faq-subtitle">{{ section_st.subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    {%- liquid
      assign has_links = false
      assign has_newsletter = false
      assign has_contact_form = false
      
      for block in section.blocks
        if block.type == 'ttl' or block.type == 'link'
          if section_st.links
            assign has_links = true
          endif
        elsif block.type == 'newsletter'
          assign has_newsletter = true
        elsif block.type == 'contact_form'
          assign has_contact_form = true
        endif
      endfor
    -%}

    <div class="faq-layout{% if has_links %} has-sidebar{% endif %}">
      
      {%- comment -%} Sidebar Links {%- endcomment -%}
      {%- if has_links -%}
        <aside class="faq-sidebar">
          <nav class="faq-nav">
            {% for block in section.blocks %}
              {% if block.type == 'ttl' or block.type == 'link' %}
                <a 
                  href="{% if block.type == 'link' %}{{ block.settings.link }}{% else %}#faq-{{ block.id }}{% endif %}"
                  class="faq-nav-link"
                  {% if block.type == 'ttl' %}data-scroll-to="faq-{{ block.id }}"{% endif %}
                >
                  {{ block.settings.title }}
                  <svg class="link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </a>
              {% endif %}
            {% endfor %}
          </nav>
        </aside>
      {%- endif -%}

      <div class="faq-content-wrapper">
        <div class="faq-main{% if has_newsletter or has_contact_form %} has-form{% endif %}">
          
          {%- comment -%} FAQ Items {%- endcomment -%}
          <div 
            id="faq-{{ section.id }}" 
            class="faq-list{% if section_st.accor %} is-accordion{% endif %}"
          >
            {% for block in section.blocks %}
              {% case block.type %}
                
                {% when 'spacing' %}
                  <div 
                    class="faq-spacer{% if block.settings.enable_bb %} has-border{% endif %}"
                    style="margin-top: {{ block.settings.mtt }}px; margin-bottom: {{ block.settings.mbb }}px;"
                  ></div>

                {% when 'ttl' %}
                  <div class="faq-category" id="faq-{{ block.id }}" {{ block.shopify_attributes }}>
                    <div class="faq-category-inner">
                      {% if block.settings.content_svg != blank %}
                        <span class="faq-category-icon">{{ block.settings.content_svg }}</span>
                      {% endif %}
                      <h3 class="faq-category-title">{{ block.settings.title }}</h3>
                    </div>
                  </div>

                {% when 'faqs' %}
                  <div 
                    class="faq-item{% if block.settings.open %} is-open{% endif %}{% unless section_st.accor %} is-static{% endunless %}" 
                    {{ block.shopify_attributes }}
                    data-faq-item
                  >
                    <div class="faq-question-wrapper"{% if section_st.accor %} onclick="toggleFAQ(this)"{% endif %}>
                      <h4 class="faq-question">{{ block.settings.title }}</h4>
                      {% if section_st.accor %}
                        <span class="faq-toggle">
                          {% if section_st.acc_style == '2' %}
                            <svg class="toggle-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                              <path d="M10 15l-5-5h10l-5 5z"/>
                            </svg>
                          {% else %}
                            <span class="toggle-plus-minus"></span>
                          {% endif %}
                        </span>
                      {% endif %}
                    </div>
                    <div class="faq-answer{% if block.settings.open or section_st.accor == false %} is-visible{% endif %}">
                      <div class="faq-answer-content">
                        {{ block.settings.answer }}
                      </div>
                    </div>
                  </div>

              {% endcase %}
            {% endfor %}
          </div>

        </div>

        {%- comment -%} Newsletter/Contact Form {%- endcomment -%}
        {% if has_newsletter or has_contact_form %}
          <aside class="faq-form-sidebar">
            {% for block in section.blocks %}
              {% if block.type == 'newsletter' %}
                <div class="faq-newsletter-block" {{ block.shopify_attributes }}>
                  {% render 'news-letter-snippet', block: block %}
                </div>
              {% elsif block.type == 'contact_form' %}
                <div class="faq-contact-block" {{ block.shopify_attributes }}>
                  {% render 'contact-form-snippet', block: block %}
                </div>
              {% endif %}
            {% endfor %}
          </aside>
        {% endif %}
      </div>

    </div>
  </div>
</div>

<script>
  function toggleFAQ(element) {
    const faqItem = element.closest('.faq-item');
    const answer = faqItem.querySelector('.faq-answer');
    const isOpen = faqItem.classList.contains('is-open');
    
    // Close all other FAQs if accordion mode
    const accordionMode = faqItem.closest('.faq-list').classList.contains('is-accordion');
    if (accordionMode && !isOpen) {
      const allItems = faqItem.closest('.faq-list').querySelectorAll('.faq-item');
      allItems.forEach(item => {
        if (item !== faqItem) {
          item.classList.remove('is-open');
          const otherAnswer = item.querySelector('.faq-answer');
          if (otherAnswer) otherAnswer.classList.remove('is-visible');
        }
      });
    }
    
    // Toggle current FAQ
    faqItem.classList.toggle('is-open');
    answer.classList.toggle('is-visible');
  }

  // Smooth scroll for sidebar links
  document.addEventListener('DOMContentLoaded', function() {
    const scrollLinks = document.querySelectorAll('[data-scroll-to]');
    scrollLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('data-scroll-to');
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  .faq-section {
    background: var(--section-bg);
    padding-top: var(--section-spacing-top);
    padding-bottom: var(--section-spacing-bottom);
    position: relative;
    overflow: hidden;
  }

  .faq-section.has-bg-img::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: var(--bg-image);
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .faq-section::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--overlay-color);
    z-index: 1;
  }

  .faq-section > .page-width,
  .faq-section > .container-fluid {
    position: relative;
    z-index: 2;
  }

  /* Header */
  .faq-header {
    margin-bottom: 50px;
  }

  .faq-main-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--title-color);
    margin-bottom: 15px;
    line-height: 1.2;
  }

  .faq-subtitle {
    font-size: 1.1rem;
    color: var(--answer-color);
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Layout */
  .faq-layout {
    display: flex;
    gap: 50px;
    align-items: flex-start;
  }

  .faq-layout.has-sidebar {
    display: grid;
    grid-template-columns: 300px 1fr;
  }

  .faq-content-wrapper {
    flex: 1;
    display: flex;
    gap: 40px;
  }

  .faq-main {
    flex: 1;
    max-width: var(--faq-max-width);
  }

  .faq-main.has-form {
    max-width: 100%;
  }

  /* Sidebar Navigation */
  .faq-sidebar {
    position: sticky;
    top: 100px;
  }

  .faq-nav {
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    padding: 20px;
    border: 1px solid var(--border-color);
  }

  .faq-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    color: var(--question-color);
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.3s ease;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .faq-nav-link:hover {
    background: rgba(0, 0, 0, 0.05);
    transform: translateX(5px);
  }

  .link-icon {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .faq-nav-link:hover .link-icon {
    opacity: 1;
  }

  /* FAQ List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* FAQ Item */
  .faq-item {
    border-bottom: 1px solid var(--border-color);
    transition: all 0.3s ease;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    cursor: pointer;
    gap: 20px;
  }

  .faq-item.is-static .faq-question-wrapper {
    cursor: default;
  }

  .faq-question {
    color: var(--question-color);
    font-size: var(--question-font-size);
    font-weight: {{ section_st.fw }};
    margin: 0;
    line-height: 1.4;
    flex: 1;
    transition: color 0.3s ease;
  }

  .faq-item:not(.is-static):hover .faq-question {
    color: var(--title-color);
  }

  /* Toggle Icon */
  .faq-toggle {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .faq-item.is-open .faq-toggle {
    background: var(--question-color);
    color: white;
  }

  .toggle-plus-minus::before {
    content: '+';
    font-size: 20px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .faq-item.is-open .toggle-plus-minus::before {
    content: '−';
  }

  .toggle-icon {
    transition: transform 0.3s ease;
  }

  .faq-item.is-open .toggle-icon {
    transform: rotate(180deg);
  }

  /* Answer */
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-answer.is-visible {
    max-height: 2000px;
  }

  .faq-answer-content {
    padding-bottom: 20px;
    color: var(--answer-color);
    font-size: var(--answer-font-size);
    line-height: 1.7;
  }

  /* Category */
  .faq-category {
    margin: 40px 0 20px;
  }

  .faq-category:first-child {
    margin-top: 0;
  }

  .faq-category-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .faq-category-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .faq-category-title {
    font-size: {{ section_st.tfs }}px;
    font-weight: {{ section_st.tfw }};
    color: var(--title-color);
    margin: 0;
  }

  /* Spacer */
  .faq-spacer.has-border {
    border-bottom: 1px solid var(--border-color);
  }

  /* Form Sidebar */
  .faq-form-sidebar {
    width: 350px;
    flex-shrink: 0;
    position: sticky;
    top: 100px;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .faq-section {
      padding-top: var(--section-spacing-top-mobile);
      padding-bottom: var(--section-spacing-bottom-mobile);
    }

    .faq-main-title {
      font-size: 2rem;
    }

    .faq-subtitle {
      font-size: 1rem;
    }

    .faq-layout.has-sidebar {
      grid-template-columns: 1fr;
    }

    .faq-sidebar {
      position: static;
      order: 2;
    }

    .faq-content-wrapper {
      flex-direction: column;
    }

    .faq-form-sidebar {
      width: 100%;
      position: static;
    }

    .faq-question {
      font-size: var(--question-font-size-mobile);
    }

    .faq-answer-content {
      font-size: var(--answer-font-size-mobile);
    }

    .faq-category-title {
      font-size: {{ section_st.tfsm }}px;
    }

    .faq-header {
      margin-bottom: 30px;
    }

    .faq-layout {
      gap: 30px;
    }
  }

  /* Visibility Classes */
  @media (max-width: 768px) {
    .hide-sm {
      display: none !important;
    }
  }

  @media (min-width: 769px) {
    .hide-md,
    .hide-lg {
      display: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Modern FAQ Section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Find answers to common questions about our products and services"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "sw",
      "label": "Full width container",
      "default": false
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "FAQ content max width",
      "default": 900,
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Accordion Settings"
    },
    {
      "type": "checkbox",
      "id": "accor",
      "label": "Enable accordion",
      "default": true,
      "info": "When enabled, only one FAQ can be open at a time"
    },
    {
      "type": "select",
      "id": "acc_style",
      "label": "Toggle icon style",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "Plus/Minus"
        },
        {
          "value": "2",
          "label": "Arrow"
        }
      ]
    },
    {
      "type": "header",
      "content": "Category Titles"
    },
    {
      "type": "color",
      "id": "tcl",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "tfs",
      "min": 16,
      "max": 48,
      "step": 1,
      "label": "Font size",
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "tfsm",
      "min": 14,
      "max": 36,
      "step": 1,
      "label": "Font size (mobile)",
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "tfw",
      "label": "Font weight",
      "default": "600",
      "options": [
        {"value": "400", "label": "Regular"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi Bold"},
        {"value": "700", "label": "Bold"}
      ]
    },
    {
      "type": "header",
      "content": "Questions"
    },
    {
      "type": "color",
      "id": "qu",
      "label": "Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "fs",
      "min": 12,
      "max": 28,
      "step": 1,
      "label": "Font size",
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "fsm",
      "min": 12,
      "max": 24,
      "step": 1,
      "label": "Font size (mobile)",
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "fw",
      "label": "Font weight",
      "default": "600",
      "options": [
        {"value": "400", "label": "Regular"},
        {"value": "500", "label": "Medium"},
        {"value": "600", "label": "Semi Bold"},
        {"value": "700", "label": "Bold"}
      ]
    },
    {
      "type": "header",
      "content": "Answers"
    },
    {
      "type": "color",
      "id": "an",
      "label": "Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "fst",
      "min": 12,
      "max": 20,
      "step": 1,
      "label": "Font size",
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "fsmt",
      "min": 12,
      "max": 18,
      "step": 1,
      "label": "Font size (mobile)",
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Sidebar Links"
    },
    {
      "type": "checkbox",
      "id": "links",
      "label": "Enable sidebar navigation",
      "default": false,
      "info": "Shows navigation links for FAQ categories"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "bgg",
      "label": "Background gradient"
    },
    {
      "type": "image_picker",
      "id": "bgimg",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "overlay",
      "label": "Image overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_op",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "Overlay opacity",
      "default": 0
    },
    {
      "type": "color",
      "id": "bdr",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "sst",
      "min": 0,
      "max": 120,
      "step": 5,
      "label": "Top spacing",
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "ssb",
      "min": 0,
      "max": 120,
      "step": 5,
      "label": "Bottom spacing",
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "sstm",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Top spacing (mobile)",
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "ssbm",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Bottom spacing (mobile)",
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hidem",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hided",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "ttl",
      "name": "Category Title",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "General Questions"
        },
        {
          "type": "html",
          "id": "content_svg",
          "label": "Icon SVG (optional)"
        }
      ]
    },
    {
      "type": "faqs",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all items. Products must be unused and in their original packaging.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "spacing",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "mtt",
          "min": 0,
          "max": 80,
          "step": 5,
          "label": "Top margin",
          "unit": "px",
          "default": 20
        },
        {
          "type": "range",
          "id": "mbb",
          "min": 0,
          "max": 80,
          "step": 5,
          "label": "Bottom margin",
          "unit": "px",
          "default": 20
        },
        {
          "type": "checkbox",
