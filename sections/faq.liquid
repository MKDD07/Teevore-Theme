{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "FAQ's"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Page Description",
      "default": "Welcome to our FAQ, we are so happy to have you here and as a client. We have tried to answer the most common questions."
    },
    {
      "type": "header",
      "content": "Contact Form"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Form Title",
      "default": "Didn't find your answer?"
    },
    {
      "type": "text",
      "id": "contact_subtitle",
      "label": "Form Subtitle",
      "default": "Don't hesitate to contact us"
    }
  ],
  "blocks": [
    {
      "type": "faq_category",
      "name": "FAQ Category",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Category Title",
          "default": "Shipping & Returns"
        },
        {
          "type": "textarea",
          "id": "category_description",
          "label": "Category Description",
          "default": "Below are some common questions about shipping, returns, and exchanges"
        }
      ]
    },
    {
      "type": "faq_question",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer text here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "blocks": [
        {
          "type": "faq_category",
          "settings": {
            "category_title": "Shipping & Returns",
            "category_description": "Below are some common questions about shipping, returns, and exchanges"
          }
        },
        {
          "type": "faq_question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>This is an example of a response that you might give. It's good to be as thorough as possible in responses as that has a tendency to improve trust overall.</p>"
          }
        },
        {
          "type": "faq_question",
          "settings": {
            "question": "When will my order be shipped?",
            "answer": "<p>Answer to when the order will be shipped.</p>"
          }
        },
        {
          "type": "faq_question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Answer to the return policy question.</p>"
          }
        },
        {
          "type": "faq_question",
          "settings": {
            "question": "How long will it take until I receive my order?",
            "answer": "<p>Answer about delivery time.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="page-width faq-section-container">
  <header class="faq-header">
    <h1 class="faq-title">{{ section.settings.title | escape }}</h1>
    <p class="faq-description">{{ section.settings.description | newline_to_br }}</p>
  </header>

  <div class="faq-content-wrapper">
    <div class="faq-accordion-column">
      {%- assign current_category = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_category' -%}
          {%- if current_category -%}
            </div> {%- endif -%}
          <div class="faq-category-header" {{ block.shopify_attributes }}>
            <h2 class="faq-category-title">{{ block.settings.category_title | escape }}</h2>
            <p class="faq-category-description">{{ block.settings.category_description | escape }}</p>
          </div>
          <div class="faq-accordion-wrapper">
          {%- assign current_category = true -%}
        {%- elsif block.type == 'faq_question' -%}
          <details class="faq-accordion-item" {{ block.shopify_attributes }}>
            <summary class="faq-accordion-summary">
              <span class="faq-question-text">{{ block.settings.question | escape }}</span>
              <span class="faq-icon">
                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-plus" viewBox="0 0 20 20"><path fill="currentColor" d="M10 5a1 1 0 0 1 1 1v3h3a1 1 0 1 1 0 2h-3v3a1 1 0 1 1-2 0v-3H6a1 1 0 1 1 0-2h3V6a1 1 0 0 1 1-1Z"/></svg>
                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-minus" viewBox="0 0 20 20"><path fill="currentColor" d="M5 9a1 1 0 0 1 0 2h10a1 1 0 1 1 0-2H5Z"/></svg>
              </span>
            </summary>
            <div class="faq-accordion-content">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {%- if current_category -%}
        </div> {%- endif -%}
    </div>

    <div class="faq-contact-column">
      <div class="faq-contact-form-wrapper">
        <h2 class="faq-contact-title">{{ section.settings.contact_title | escape }}</h2>
        <p class="faq-contact-subtitle">{{ section.settings.contact_subtitle | escape }}</p>

        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <p class="form-success">Your message has been sent successfully!</p>
          {% else %}
            {{ form.errors | default_errors }}
            <div class="field">
              <label class="visually-hidden" for="ContactFormName-{{ section.id }}">Name</label>
              <input type="text" id="ContactFormName-{{ section.id }}" name="contact[name]" placeholder="Name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="field">
              <label class="visually-hidden" for="ContactFormEmail-{{ section.id }}">Email</label>
              <input type="email" id="ContactFormEmail-{{ section.id }}" name="contact[email]" placeholder="Email" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
            </div>
            <div class="field">
              <label class="visually-hidden" for="ContactFormMessage-{{ section.id }}">Message</label>
              <textarea rows="6" id="ContactFormMessage-{{ section.id }}" name="contact[body]" placeholder="Message">{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>
            <button type="submit" class="button">Send message</button>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<style>
  .faq-section-container {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .faq-header {
    margin-bottom: 4rem;
  }
  .faq-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .faq-description {
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.75);
    max-width: 600px;
  }
  .faq-content-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
    align-items: flex-start;
  }
  .faq-accordion-column {
    flex: 1 1 60%;
  }
  .faq-contact-column {
    flex: 1 1 30%;
    min-width: 300px;
  }

  /* Accordion Styles */
  .faq-category-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .faq-category-description {
    margin-bottom: 2rem;
    color: rgba(var(--color-foreground), 0.75);
  }
  .faq-accordion-wrapper {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 3rem;
    background: rgb(var(--color-background));
  }
  .faq-accordion-item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }
  .faq-accordion-item:last-child {
    border-bottom: none;
  }
  .faq-accordion-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
  }
  .faq-accordion-summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: flex;
    align-items: center;
    margin-left: 1rem;
  }
  .faq-icon .icon {
    width: 1.2rem;
    height: 1.2rem;
  }
  .faq-icon .icon-minus {
    display: none;
  }
  details[open] .faq-icon .icon-plus {
    display: none;
  }
  details[open] .faq-icon .icon-minus {
    display: block;
  }
  .faq-accordion-content {
    padding: 0 1.5rem 1.5rem;
    color: rgba(var(--color-foreground), 0.75);
    line-height: 1.6;
  }

  /* Contact Form Styles */
  .faq-contact-form-wrapper {
    padding: 2rem;
  }
  .faq-contact-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .faq-contact-subtitle {
    margin-bottom: 2rem;
    color: rgba(var(--color-foreground), 0.75);
  }
  .faq-contact-form-wrapper .field {
    margin-bottom: 1rem;
  }
  .faq-contact-form-wrapper input,
  .faq-contact-form-wrapper textarea {
    width: 100%;
    padding: 1rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 4px;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-family: inherit;
  }
  .faq-contact-form-wrapper textarea {
    resize: vertical;
  }
  .faq-contact-form-wrapper .button {
    width: 100%;
    margin-top: 1rem;
  }
  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    word-wrap: normal !important;
  }
  .form-success {
    color: rgb(var(--color-success, green));
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 990px) {
    .faq-content-wrapper {
      flex-direction: column;
    }
    .faq-contact-column {
      width: 100%;
      margin-top: 2rem;
    }
    .faq-contact-form-wrapper {
      padding: 0;
    }
  }
</style>