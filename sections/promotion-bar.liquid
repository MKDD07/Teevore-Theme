          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <div class="promo-content">
      {%- if promotion_blocks.size > 0 -%}
        {%- if promotion_blocks.size > 1 -%}
          <div class="promo-slider" data-autoplay="{{ section_st.autoplay }}" data-speed="{{ section_st.speed }}">
            <div class="promo-slides">
        {%- endif -%}

        {%- for block in promotion_blocks -%}
          {%- assign blk_st = block.settings -%}
          <div class="promo-slide" {{ block.shopify_attributes }}>
            {%- if blk_st.title != blank -%}
              <a 
                {% if blk_st.link != blank %}href="{{ blk_st.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                class="promo-message"
              >
                {%- assign display_title = blk_st.title -%}
                
                {%- comment -%} Handle countdown {%- endcomment -%}
                {%- if display_title contains '[countdown]' -%}
                  {%- capture countdown_html -%}
                    <span class="promo-countdown" data-date="{{ blk_st.date | default: '12/31/2024' }}">
                      <span><span class="time-value">00</span>d<span class="time-separator">:</span></span>
                      <span><span class="time-value">00</span>h<span class="time-separator">:</span></span>
                      <span><span class="time-value">00</span>m<span class="time-separator">:</span></span>
                      <span><span class="time-value">00</span>s</span>
                    </span>
                  {%- endcapture -%}
                  {%- assign display_title = display_title | replace: '[countdown]', countdown_html -%}
                {%- endif -%}

                {%- comment -%} Handle button {%- endcomment -%}
                {%- if display_title contains '[button]' and blk_st.btn_txt != blank -%}
                  {%- capture button_html -%}
                    <span class="promo-btn{% if blk_st.hdbtn %} hide-mobile{% endif %}">{{ blk_st.btn_txt }}</span>
                  {%- endcapture -%}
                  {%- assign display_title = display_title | replace: '[button]', button_html -%}
                {%- endif -%}

                {{ display_title }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if promotion_blocks.size > 1 -%}
            </div>
            {%- if section_st.arrow or section_st.arrowm -%}
              <button class="promo-arrow promo-arrow-prev" aria-label="Previous">‹</button>
              <button class="promo-arrow promo-arrow-next" aria-label="Next">›</button>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- comment -%} Right Side: Currency/Language/Track Order {%- endcomment -%}
    {%- if currency_blocks.size > 0 -%}
      {%- assign currency_block = currency_blocks.first -%}
      {%- assign cl_st = currency_block.settings -%}
      <div class="promo-side-section promo-side-right">
        
        {%- comment -%} Social Media (optional) {%- endcomment -%}
        {%- if cl_st.sc -%}
          <div class="promo-social">
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Custom Menu {%- endcomment -%}
        {%- if cl_st.menu != blank and linklists[cl_st.menu].links.size > 0 -%}
          <div class="promo-menu-links">
            {%- for link in linklists[cl_st.menu].links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} Custom Text {%- endcomment -%}
        {%- if cl_st.txt != blank -%}
          <div class="promo-custom-text">{{ cl_st.txt }}</div>
        {%- endif -%}

        <div class="promo-selectors">
          {%- comment -%} Currency Selector {%- endcomment -%}
          {%- if settings.mlcurrency -%}
            {%- form 'currency', class: 'promo-selector' -%}
              <select name="currency" aria-label="Currency" onchange="this.form.submit();">
                {%- for currency in shop.enabled_currencies -%}
                  <option value="{{ currency.iso_code }}" {% if currency == cart.currency %}selected{% endif %}>
                    {{ currency.iso_code }} {{ currency.symbol }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          {%- endif -%}

          {%- comment -%} Language Selector {%- endcomment -%}
          {%- if settings.mlLang and shop.published_locales.size > 1 -%}
            {%- form 'localization', class: 'promo-selector' -%}
              <select name="locale_code" aria-label="Language" onchange="this.form.submit();">
                {%- for locale in shop.published_locales -%}
                  <option value="{{ locale.iso_code }}" {% if locale == request.locale %}selected{% endif %}>
                    {{ locale.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endform -%}
          {%- endif -%}

          {%- comment -%} Track Order Button {%- endcomment -%}
          {%- unless settings.mlcurrency or settings.mlLang -%}
            {%- if section_st.track_order != blank -%}
              <a href="{{ section_st.track_order }}" class="promo-track-btn">
                {{ section_st.track_order_text | default: 'Track Order' }}
              </a>
            {%- endif -%}
          {%- endunless -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{%- if promotion_blocks.size > 1 and section_st.autoplay -%}
<script>
(function() {
  const slider = document.querySelector('#shopify-section-{{ section.id }} .promo-slider');
  if (!slider) return;
  
  const slides = slider.querySelector('.promo-slides');
  const prevBtn = slider.querySelector('.promo-arrow-prev');
  const nextBtn = slider.querySelector('.promo-arrow-next');
  const slideCount = slides.children.length;
  let currentIndex = 0;
  const speed = {{ section_st.speed | times: 1000 }};
  let autoplayInterval;

  function goToSlide(index) {
    currentIndex = (index + slideCount) % slideCount;
    slides.style.transform = `translateX(-${currentIndex * 100}%)`;
  }

  function nextSlide() {
    goToSlide(currentIndex + 1);
  }

  function prevSlide() {
    goToSlide(currentIndex - 1);
  }

  if (prevBtn) prevBtn.addEventListener('click', prevSlide);
  if (nextBtn) nextBtn.addEventListener('click', nextSlide);

  if (slider.dataset.autoplay === 'true') {
    autoplayInterval = setInterval(nextSlide, speed);
    slider.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
    slider.addEventListener('mouseleave', () => {
      autoplayInterval = setInterval(nextSlide, speed);
    });
  }
})();
</script>
{%- endif -%}
