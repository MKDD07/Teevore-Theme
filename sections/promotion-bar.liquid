{%- liquid
  assign section_st = section.settings
  assign promotion_blocks = section.blocks | where: 'type', 'bar'
  assign social_blocks = section.blocks | where: 'type', 'sc'
  assign currency_blocks = section.blocks | where: 'type', 'cl'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }
  
  #{{ section.id }} {
    --promo-fs: {{ section_st.fts }}px;
    --promo-fsm: {{ section_st.ftsm }}px;
    --promo-lh: {{ section_st.lh }};
    --promo-fw: {{ section_st.fw }};
    --promo-cl: {{ section_st.cl }};
    --promo-clhl: {{ section_st.clhl }};
    --promo-btncl: {{ section_st.btncl }};
    --promo-btnbg: {{ section_st.btnbg }};
    --promo-cnt: {{ section_st.cnt_txt }};
    --promo-bg: {% if section_st.bgg != blank %}{{ section_st.bgg }}{% else %}#000000{% endif %};
    --promo-overlay: {{ section_st.overlay | color_modify: 'alpha', section_st.overlay_op }};
    --promo-sst: {{ section_st.sst }}px;
    --promo-ssb: {{ section_st.ssb }}px;
    --promo-sstm: {{ section_st.sstm }}px;
    --promo-ssbm: {{ section_st.ssbm }}px;
  }

  .promo-bar-wrapper {
    background: var(--promo-bg);
    position: relative;
    padding-top: var(--promo-sst);
    padding-bottom: var(--promo-ssb);
  }

  @media (max-width: 749px) {
    .promo-bar-wrapper {
      padding-top: var(--promo-sstm);
      padding-bottom: var(--promo-ssbm);
    }
  }

  {%- if section_st.bgimg != blank -%}
    .promo-bar-wrapper::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: url('{{ section_st.bgimg | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      z-index: 0;
    }
    .promo-bar-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--promo-overlay);
      z-index: 1;
    }
  {%- endif -%}

  .promo-bar-container {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    {% unless section_st.sw %}max-width: 1200px; margin: 0 auto; padding: 0 20px;{% endunless %}
  }

  .promo-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
  }

  .promo-message {
    font-family: var(--{{ section_st.fontFm }});
    font-size: var(--promo-fs);
    font-weight: var(--promo-fw);
    line-height: var(--promo-lh);
    color: var(--promo-cl);
    text-align: center;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 0;
  }

  @media (max-width: 749px) {
    .promo-message {
      font-size: var(--promo-fsm);
    }
  }

  .promo-message .hl {
    color: var(--promo-clhl);
  }

  .promo-message .promo-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    background: var(--promo-btnbg);
    color: var(--promo-btncl);
    border-radius: 4px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .promo-message .promo-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  @media (max-width: 749px) {
    .promo-message .promo-btn.hide-mobile {
      display: none;
    }
  }

  .promo-countdown {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--promo-cnt);
    font-weight: 700;
    text-transform: uppercase;
  }

  .promo-countdown span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .promo-countdown .time-value {
    font-size: 1.1em;
  }

  .promo-countdown .time-separator {
    margin: 0 2px;
  }

  .promo-side-section {
    display: flex;
    align-items: center;
    gap: 15px;
    min-width: 180px;
  }

  @media (max-width: 989px) {
    .promo-side-section {
      display: none;
    }
  }

  .promo-side-left {
    justify-content: flex-start;
  }

  .promo-side-right {
    justify-content: flex-end;
  }

  .promo-social {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .promo-social a {
    color: var(--promo-cl);
    font-size: 18px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .promo-social a:hover {
    color: var(--promo-clhl);
    transform: scale(1.1);
  }

  .promo-menu-links {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .promo-menu-links a {
    color: var(--promo-cl);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .promo-menu-links a:hover {
    color: var(--promo-clhl);
  }

  .promo-selectors {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .promo-selector {
    position: relative;
  }

  .promo-selector select,
  .promo-track-btn {
    background: transparent;
    border: 1px solid var(--promo-cl);
    color: var(--promo-cl);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .promo-selector select:hover,
  .promo-track-btn:hover {
    background: var(--promo-cl);
    color: var(--promo-bg);
  }

  .promo-track-btn {
    text-decoration: none;
    display: inline-block;
    font-weight: 600;
    white-space: nowrap;
  }

  {%- if promotion_blocks.size > 1 -%}
    .promo-slider {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    .promo-slides {
      display: flex;
      transition: transform 0.5s ease;
    }

    .promo-slide {
      min-width: 100%;
      flex-shrink: 0;
    }

    {%- if section_st.arrow or section_st.arrowm -%}
      .promo-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.2);
        border: none;
        color: var(--promo-cl);
        width: 30px;
        height: 30px;
        border-radius: 50%;
        cursor: pointer;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        {% if section_st.arr_show == 'hover' %}opacity: 0;{% endif %}
      }

      .promo-bar-wrapper:hover .promo-arrow {
        opacity: 1;
      }

      .promo-arrow:hover {
        background: rgba(255,255,255,0.4);
      }

      .promo-arrow-prev {
        left: 10px;
      }

      .promo-arrow-next {
        right: 10px;
      }

      @media (max-width: 749px) {
        .promo-arrow {
          {% unless section_st.arrowm %}display: none;{% endunless %}
        }
      }

      @media (min-width: 750px) {
        .promo-arrow {
          {% unless section_st.arrow %}display: none;{% endunless %}
        }
      }
    {%- endif -%}
  {%- endif -%}

  @media (max-width: 749px) {
    #{{ section.id }}.hide-mobile {
      display: none;
    }
  }

  @media (min-width: 750px) {
    #{{ section.id }}.hide-desktop {
      display: none;
    }
  }
{%- endstyle -%}

<div 
  id="shopify-section-{{ section.id }}" 
  class="promo-bar-wrapper{% if section_st.hidem %} hide-mobile{% endif %}{% if section_st.hided %} hide-desktop{% endif %}"
>
  <div id="{{ section.id }}" class="promo-bar-container">
<script>
(function() {
  const countdowns = document.querySelectorAll('#shopify-section-{{ section.id }} .promo-countdown');
  
  countdowns.forEach(countdown => {
    const dateStr = countdown.dataset.date;
    if (!dateStr) return;
    
    const [month, day, year] = dateStr.split('/');
    const endDate = new Date(year, month - 1, day, 23, 59, 59).getTime();
    
    function updateCountdown() {
      const now = new Date().getTime();
      const distance = endDate - now;
      
      if (distance < 0) {
        countdown.innerHTML = 'EXPIRED';
        return;
      }
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      
      const values = countdown.querySelectorAll('.time-value');
      if (values[0]) values[0].textContent = String(days).padStart(2, '0');
      if (values[1]) values[1].textContent = String(hours).padStart(2, '0');
      if (values[2]) values[2].textContent = String(minutes).padStart(2, '0');
      if (values[3]) values[3].textContent = String(seconds).padStart(2, '0');
    }
    
    updateCountdown();
    setInterval(updateCountdown, 1000);
  });
})();
</script>

{% schema %}
{
  "name": "Promotion Bar",
