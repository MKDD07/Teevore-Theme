{% schema %}
  {
    "name": "Section New Banner",
    "settings": [
      {
        "type": "header",
        "content": "Section Layout"
      },
      {
        "type": "range",
        "id": "desktop_columns",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 3,
        "label": "Desktop Columns",
        "info": "Number of columns for desktop view."
      },
      {
        "type": "header",
        "content": "Mobile Settings"
      },
      {
        "type": "checkbox",
        "id": "sticky_mobile",
        "label": "Enable Sticky for Mobile (<576px)",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "image_item",
        "name": "Image Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Big Sale"
          },
          {
            "type": "textarea",
            "id": "subtitle",
            "label": "Subtitle",
            "default": "Get up to 50% off your favorite styles — only for a limited time!"
          },
          {
            "type": "url",
            "id": "link_url",
            "label": "Link URL"
          },
          {
            "type": "color",
            "id": "overlay_background",
            "label": "Overlay Background Color",
            "default": "#F0E1D5"
          },
          {
            "type": "color",
            "id": "title_color",
            "label": "Title Color",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "subtitle_color",
            "label": "Subtitle Color",
            "default": "#666666"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image Grid with Text Overlay",
        "blocks": [
          {
            "type": "image_item"
          },
          {
            "type": "image_item",
            "settings": {
              "title": "New Drop",
              "subtitle": "Discover the latest arrivals — trend-forward, fresh, and ready to wear.",
              "overlay_background": "#F0E1D5"
            }
          },
          {
            "type": "image_item",
            "settings": {
              "title": "Summer Vibes",
              "subtitle": "Breezy fabrics, bright colors, and effortless looks for sunny days.",
              "overlay_background": "#FDF8BB"
            }
          }
        ]
      }
    ]
  }
{% endschema %}

<style>
  .image-grid-section {
    display: grid;
    padding: 20px 0; /* Adjust padding as needed */
  }

  .image-grid-item {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Align content to the bottom */
  }

  .image-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

.image-overlay {
    position: absolute;
    width: 90%;
    left: 50%;                /* horizontally center */
    transform: translateX(-50%); /* adjust for centering */
    padding: 20px;
    text-align: center;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    backdrop-filter: saturate(180%) blur(20px);
    opacity: 100%;
    bottom: 10px;
}

  .image-overlay-title {
    font-size: 2.5em; /* Adjust as needed */
    font-weight: bold;
    margin-bottom: 10px;
  }

  .image-overlay-subtitle {
    font-size: 1.1em; /* Adjust as needed */
    line-height: 1.4;
  }

  /* Desktop Styles */
  @media (min-width: 577px) {
    .image-grid-section {
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    }
    .image-overlay {
      bottom: 0;
      height: auto;
    }
  }

  /* Mobile Styles */
  @media (max-width: 576px) {
    .image-grid-section {
      grid-template-columns: 1fr; /* Stack items on mobile */
      grid-auto-rows: minmax(400px, auto); /* Set a minimum height for mobile images */
    }
    .image-grid-item {
      min-height: 400px; /* Ensure images have a decent height on mobile */
    }

    {% if section.settings.sticky_mobile %}
      .image-overlay {
        position: sticky;
        bottom: 0;
        top: auto; /* Ensure it sticks to the bottom */
        z-index: 10;
        transform: translateY(0%); /* Reset any potential transform for sticky */
        height: auto;
      }
      .image-grid-item {
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Push image to top, overlay to bottom */
      }
      .image-grid-item img {
        height: auto;
        flex-grow: 1; /* Allow image to take available space */
      }
    {% else %}
      .image-overlay {
        bottom: 0;
        height: auto;
      }
    {% endif %}
    .image-overlay-title {
      font-size: 2em; /* Adjust for mobile */
    }
    .image-overlay-subtitle {
      font-size: 0.9em; /* Adjust for mobile */
    }
  }
</style>

<div class="image-grid-section">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link_url }}" class="image-grid-item" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}
        <img
          srcset="
            {% if block.settings.image.width >= 375 %}{{ block.settings.image | img_url: '375x' }} 375w,{% endif %}
            {% if block.settings.image.width >= 750 %}{{ block.settings.image | img_url: '750x' }} 750w,{% endif %}
            {% if block.settings.image.width >= 1100 %}{{ block.settings.image | img_url: '1100x' }} 1100w,{% endif %}
            {% if block.settings.image.width >= 1500 %}{{ block.settings.image | img_url: '1500x' }} 1500w,{% endif %}
            {% if block.settings.image.width >= 1780 %}{{ block.settings.image | img_url: '1780x' }} 1780w,{% endif %}
            {% if block.settings.image.width >= 2000 %}{{ block.settings.image | img_url: '2000x' }} 2000w,{% endif %}
            {% if block.settings.image.width >= 3000 %}{{ block.settings.image | img_url: '3000x' }} 3000w,{% endif %}
            {% if block.settings.image.width >= 3840 %}{{ block.settings.image | img_url: '3840x' }} 3840w,{% endif %}
            {{ block.settings.image | img_url: 'master' }} {{ block.settings.image.width }}w
          "
          src="{{ block.settings.image | img_url: '1100x' }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      <div class="image-overlay">
        <h2 class="image-overlay-title kar" style="color: {{ block.settings.title_color }};">
          {{ block.settings.title }}
        </h2>
        <p class="image-overlay-subtitle" style="color: {{ block.settings.subtitle_color }};">
          {{ block.settings.subtitle }}
        </p>
      </div>
    </a>
  {% endfor %}
</div>