{% schema %}
{
  "name": "Scroll Logo Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Visual Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Strip Background Color",
      "default": "#ffe97d"
    },
    {
      "type": "range",
      "id": "rotation_angle",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "deg",
      "label": "Tilt Angle",
      "default": -3
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Section Total Height",
      "default": 200,
      "info": "Increase this to see more of the faded background logos."
    },
    {
      "type": "header",
      "content": "Movement Settings"
    },
    {
      "type": "range",
      "id": "base_speed",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Base Speed",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "scroll_sensitivity",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "label": "Scroll Sensitivity",
      "default": 3.0
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual Scroll Marquee",
      "blocks": [
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"}
      ]
    }
  ]
}
{% endschema %}

<style>
  .marquee-section-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent; /* Or white depending on your theme */
  }

  /* --- SHARED STYLES --- */
  .marquee-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    padding: 0;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: {{ section.settings.logo_gap }}px;
  }

  /* --- BACKGROUND LAYER (Faded, Behind) --- */
  .marquee-background-layer {
    position: absolute;
    top: 50%;
    left: 0;
    width: 120vw;
    margin-left: -10vw;
    transform: translateY(-50%) rotate({{ section.settings.rotation_angle }}deg);
    z-index: 1;
    pointer-events: none; /* Let clicks pass through */
  }

  .marquee-background-layer .marquee-item img {
    height: {{ section.settings.logo_height | times: 1.5 }}px; /* Background logos slightly bigger */
    width: auto;
    display: block;
    opacity: 0.12; /* Faded */
    filter: grayscale(100%);
    mix-blend-mode: luminosity; /* User request */
  }

  /* --- FOREGROUND LAYER (Yellow Strip) --- */
  .marquee-foreground-layer {
    position: relative;
    z-index: 2;
    background-color: {{ section.settings.bg_color }};
    width: 120vw;
    margin-left: -10vw;
    transform: rotate({{ section.settings.rotation_angle }}deg);
    padding: 15px 0;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    display: flex;
    align-items: center;
  }

  .marquee-foreground-layer .marquee-item img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: grayscale(100%) contrast(1.2); 
    transition: opacity 0.3s;
  }
  
  .marquee-foreground-layer .marquee-item img:hover {
    opacity: 0.7;
  }
</style>

<div class="marquee-section-wrapper">
  
  <!-- BACKGROUND MARQUEE (Moves Reverse) -->
  <div class="marquee-background-layer">
    <div class="marquee-track" id="MarqueeTrackBack-{{ section.id }}">
      {% for i in (1..6) %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="marquee-item">
              {{ block.settings.image | image_url: height: 300 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <!-- FOREGROUND MARQUEE (Moves Normal) -->
  <div class="marquee-foreground-layer">
    <div class="marquee-track" id="MarqueeTrackFront-{{ section.id }}">
      {% for i in (1..6) %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="marquee-item">
              {{ block.settings.image | image_url: height: 200 | image_tag: alt: block.settings.alt_text, loading: 'lazy' }}
            </div>
          {% else %}
            <!-- Placeholder -->
            <div class="marquee-item">
               <span style="font-weight:bold; font-size: 24px; opacity: 0.3;">LOGO</span>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>

</div>

<script>
  (function() {
    const trackFront = document.getElementById('MarqueeTrackFront-{{ section.id }}');
    const trackBack = document.getElementById('MarqueeTrackBack-{{ section.id }}');
    
    if (!trackFront || !trackBack) return;

    // Settings
    const baseSpeed = {{ section.settings.base_speed }};
    const sensitivity = {{ section.settings.scroll_sensitivity }};
    
    // State
    let posFront = 0;
    let posBack = 0;
    
    let targetSpeed = baseSpeed;
    let currentSpeed = baseSpeed;
    
    let lastScrollY = window.scrollY;

    function animate() {
      // 1. Calculate Scroll Velocity
      const newScrollY = window.scrollY;
      const scrollDelta = newScrollY - lastScrollY;
      lastScrollY = newScrollY;

      // 2. Adjust Speed based on Scroll
      // Scrolling down adds speed, Scrolling up subtracts speed
      targetSpeed = baseSpeed + (scrollDelta * (sensitivity * 0.1));

      // 3. Smooth Lerp
      currentSpeed += (targetSpeed - currentSpeed) * 0.1;

      // 4. Return to Base Speed (Friction)
      targetSpeed += (baseSpeed - targetSpeed) * 0.05;

      // 5. Update Positions
      // Front moves Left (negative)
      posFront -= currentSpeed;
      
      // Back moves Right (positive) - Opposite Direction
      posBack += currentSpeed; 
      // Note: If you want Back to simply be slower but same direction, change += to -= and multiply currentSpeed by 0.5

      // 6. Infinite Loop Logic
      const widthFront = trackFront.scrollWidth / 2; // Assuming we duplicated enough
      const widthBack = trackBack.scrollWidth / 2;

      // Reset Front
      if (posFront <= -widthFront) posFront = 0;
      if (posFront > 0) posFront = -widthFront;

      // Reset Back
      if (posBack <= -widthBack) posBack = 0;
      if (posBack > 0) posBack = -widthBack; 
      // Since Back moves positive usually, we need to check if it goes past 0 towards right?
      // Actually, standard logic: keep it within -width to 0.
      // If moving right (positive), we start at -width and move to 0.
      
      // Fix for Right Movement (Background):
      // If we move right, posBack increases. If it hits 0 (start), snap back to -widthBack (end)
      if (posBack >= 0) posBack = -widthBack;
      if (posBack < -widthBack) posBack = 0;

      // 7. Apply Transforms
      trackFront.style.transform = `translate3d(${posFront}px, 0, 0)`;
      trackBack.style.transform = `translate3d(${posBack}px, 0, 0)`;

      requestAnimationFrame(animate);
    }

    // Initialize positions to avoid jump
    posBack = -trackBack.scrollWidth / 2; 

    requestAnimationFrame(animate);

  })();
</script>