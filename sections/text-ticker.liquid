{% schema %}
{
  "name": "Scroll Logo Marquee",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffe97d"
    },
    {
      "type": "range",
      "id": "rotation_angle",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "deg",
      "label": "Tilt Angle",
      "default": -3
    },
    {
      "type": "range",
      "id": "base_speed",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Base Speed",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "scroll_sensitivity",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "label": "Scroll Sensitivity",
      "info": "How much faster it goes when scrolling",
      "default": 2.5
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scroll Logo Marquee",
      "blocks": [
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"}
      ]
    }
  ]
}
{% endschema %}

<style>
  .marquee-section-wrapper {
    overflow: hidden;
    padding: 60px 0; /* Space for the tilt so it doesn't clip */
    width: 100%;
    position: relative;
    background: transparent;
  }

  .marquee-tilted-container {
    background-color: {{ section.settings.bg_color }};
    transform: rotate({{ section.settings.rotation_angle }}deg) scale(1.05); /* Scale ensures edges are covered when rotated */
    width: 100%;
    padding: 20px 0;
    display: flex;
    align-items: center;
    /* Create a wide surface for the track */
    width: 120vw; 
    margin-left: -10vw;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform; /* Performance optimization */
  }

  .marquee-item {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: {{ section.settings.logo_gap }}px;
    flex-shrink: 0;
  }

  .marquee-item img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
    display: block;
    /* Convert black logos to pure black if needed, or keep original */
    filter: grayscale(100%) contrast(1.2); 
    transition: opacity 0.3s;
  }
  
  .marquee-item img:hover {
    opacity: 0.7;
  }
</style>

<div class="marquee-section-wrapper">
  <div class="marquee-tilted-container">
    <div class="marquee-track" id="MarqueeTrack-{{ section.id }}">
      <!-- We render the blocks twice to ensure there is enough content to loop visually before JS takes over -->
      {% for i in (1..4) %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            <div class="marquee-item">
              {{ block.settings.image | image_url: height: 200 | image_tag: alt: block.settings.alt_text, loading: 'lazy' }}
            </div>
          {% else %}
             <!-- Placeholder for setup -->
            <div class="marquee-item">
               <span style="font-weight:bold; font-size: 24px; opacity: 0.3;">LOGO</span>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function() {
    const track = document.getElementById('MarqueeTrack-{{ section.id }}');
    if (!track) return;

    // Settings from Liquid
    const baseSpeed = {{ section.settings.base_speed }};
    const sensitivity = {{ section.settings.scroll_sensitivity }};
    
    // State variables
    let currentPos = 0;
    let targetSpeed = baseSpeed;
    let currentSpeed = baseSpeed;
    let lastScrollY = window.scrollY;
    let isHovered = false;

    // Calculate width of one full set of items (approximate)
    // In a real loop, we just keep moving and reset when the first item is fully off-screen
    // A simpler approach for infinite scrolling:
    
    function animate() {
      // 1. Determine scroll velocity
      const newScrollY = window.scrollY;
      const scrollDelta = newScrollY - lastScrollY;
      lastScrollY = newScrollY;

      // 2. Add scroll velocity to speed
      // If scrolling down (positive delta), speed increases.
      // If scrolling up (negative delta), speed decreases or reverses.
      // We multiply by sensitivity.
      targetSpeed = baseSpeed + (scrollDelta * (sensitivity * 0.1));

      // 3. Smoothness (Linear Interpolation - Lerp)
      // This makes the speed ramp up and down smoothly instead of jerking
      currentSpeed += (targetSpeed - currentSpeed) * 0.1;

      // 4. Always try to return to base speed (Friction)
      // If user stops scrolling, targetSpeed should drift back to baseSpeed
      targetSpeed += (baseSpeed - targetSpeed) * 0.05;

      // 5. Update Position
      currentPos -= currentSpeed;

      // 6. Logic for Infinite Loop
      // If we've moved far enough left (negative), reset to 0
      // We use the scrollWidth / 2 because we duplicated items enough times
      // to cover the screen.
      const trackWidth = track.scrollWidth;
      const windowWidth = window.innerWidth;
      
      // If the track has moved more than half its width, reset
      // This assumes we have enough duplicates (which we did in Liquid loop)
      if (currentPos <= -(trackWidth / 2)) {
        currentPos = 0;
      }
      
      // If we move too far right (reverse scroll), reset to the middle
      if (currentPos > 0) {
        currentPos = -(trackWidth / 2);
      }

      // 7. Apply Transform
      track.style.transform = `translate3d(${currentPos}px, 0, 0)`;

      requestAnimationFrame(animate);
    }

    // Start the loop
    requestAnimationFrame(animate);

    // Optional: Pause on hover?
    // track.addEventListener('mouseenter', () => currentSpeed = 0); 
    // track.addEventListener('mouseleave', () => currentSpeed = baseSpeed);

  })();
</script>