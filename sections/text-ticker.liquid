{% schema %}
{
  "name": "Scroll Logo Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Visual Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Strip Background Color",
      "default": "#ffe97d"
    },
    {
      "type": "range",
      "id": "rotation_angle",
      "min": -10,
      "max": 10,
      "step": 1,
      "unit": "deg",
      "label": "Tilt Angle",
      "default": -3
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Section Total Height",
      "default": 200,
      "info": "Increase this to see more of the faded background logos."
    },
    {
      "type": "header",
      "content": "Movement Settings"
    },
    {
      "type": "range",
      "id": "base_speed",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Base Speed",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "scroll_sensitivity",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "label": "Scroll Sensitivity",
      "default": 3.0
    },
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Gap between logos",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual Scroll Marquee",
      "blocks": [
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"},
        {"type": "logo"}
      ]
    }
  ]
}
{% endschema %}

<style>
  .marquee-section-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
  }

  .marquee-layer {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: {{ section.settings.logo_gap }}px;
  }

  /* BACKGROUND LAYER (Faded, Behind) */
  .marquee-background-layer {
    top: 50%;
    transform: translateY(-50%) rotate({{ section.settings.rotation_angle }}deg);
    z-index: 1;
    pointer-events: none;
  }

  .marquee-background-layer .marquee-item img {
    height: {{ section.settings.logo_height | times: 1.5 }}px;
    width: auto;
    display: block;
    opacity: 0.12;
    filter: grayscale(100%);
    mix-blend-mode: luminosity;
  }

  /* FOREGROUND LAYER (Yellow Strip) */
  .marquee-foreground-layer {
    top: 50%;
    transform: translateY(-50%) rotate({{ section.settings.rotation_angle }}deg);
    z-index: 2;
    background-color: {{ section.settings.bg_color }};
    padding: 15px 0;
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
  }

  .marquee-foreground-layer .marquee-track {
    padding: 0;
  }

  .marquee-foreground-layer .marquee-item img {
    height: {{ section.settings.logo_height }}px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: grayscale(100%) contrast(1.2); 
    transition: opacity 0.3s;
  }
  
  .marquee-foreground-layer .marquee-item img:hover {
    opacity: 0.7;
  }

  .marquee-item span {
    font-weight: bold;
    font-size: 24px;
    opacity: 0.3;
  }
</style>

<div class="marquee-section-wrapper">

  <!-- FOREGROUND MARQUEE (Moves Normal) -->
  <div class="marquee-layer marquee-foreground-layer">
    <div class="marquee-track" data-marquee="foreground-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="marquee-item">
            {{ block.settings.image | image_url: height: 200 | image_tag: alt: block.settings.alt_text, loading: 'lazy' }}
          </div>
        {% else %}
          <div class="marquee-item">
            <span>LOGO</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

</div>

<script>
(function() {
  const foregroundTrack = document.querySelector('[data-marquee="foreground-{{ section.id }}"]');
  const backgroundTrack = document.querySelector('[data-marquee="background-{{ section.id }}"]');
  
  if (!foregroundTrack || !backgroundTrack) return;

  const settings = {
    baseSpeed: {{ section.settings.base_speed }},
    sensitivity: {{ section.settings.scroll_sensitivity }}
  };

  // Clone content for seamless loop
  function setupMarquee(track) {
    const content = track.innerHTML;
    // Triple the content for smooth infinite scroll
    track.innerHTML = content + content + content;
  }

  setupMarquee(foregroundTrack);
  setupMarquee(backgroundTrack);

  let foregroundPos = 0;
  let backgroundPos = 0;
  let currentSpeed = settings.baseSpeed;
  let targetSpeed = settings.baseSpeed;
  let lastScrollY = window.scrollY;

  function animate() {
    // Calculate scroll delta
    const newScrollY = window.scrollY;
    const scrollDelta = newScrollY - lastScrollY;
    lastScrollY = newScrollY;

    // Adjust target speed based on scroll
    targetSpeed = settings.baseSpeed + (scrollDelta * settings.sensitivity * 0.1);

    // Smooth interpolation
    currentSpeed += (targetSpeed - currentSpeed) * 0.1;

    // Decay back to base speed
    targetSpeed += (settings.baseSpeed - targetSpeed) * 0.05;

    // Update positions
    foregroundPos -= currentSpeed;
    backgroundPos += currentSpeed * 0.6; // Opposite direction, slightly slower

    // Get track widths (divide by 3 since we tripled content)
    const foregroundWidth = foregroundTrack.scrollWidth / 3;
    const backgroundWidth = backgroundTrack.scrollWidth / 3;

    // Loop foreground (moving left)
    if (foregroundPos <= -foregroundWidth) {
      foregroundPos += foregroundWidth;
    }

    // Loop background (moving right)
    if (backgroundPos >= backgroundWidth) {
      backgroundPos -= backgroundWidth;
    }

    // Apply transforms
    foregroundTrack.style.transform = `translate3d(${foregroundPos}px, 0, 0)`;
    backgroundTrack.style.transform = `translate3d(${backgroundPos}px, 0, 0)`;

    requestAnimationFrame(animate);
  }

  // Start animation
  requestAnimationFrame(animate);
})();
</script>