      "blocks": {
        "faqs_1": {
          "type": "faqs",
          "settings": {
            "title": "What sizes are available for Teevore T-shirts?",
            "answer": "<p>Our T-shirts are available in sizes XS to XXL. Please refer to the size guide on each product page for exact measurements.</p>",
            "open": false
          }
        },
        "faqs_2": {
          "type": "faqs",
          "settings": {
            "title": "What material are your T-shirts made from?",
            "answer": "<p>Teevore T-shirts are made from 100% premium cotton, offering a soft, breathable, and long-lasting wear.</p>",
            "open": false
          }
        },
        "faqs_3": {
          "type": "faqs",
          "settings": {
            "title": "How should I wash and care for my T-shirt?",
            "answer": "<p>We recommend machine washing cold with like colors and tumble drying on low. Avoid bleach and ironing directly on prints.</p>",
            "open": false
          }
        },
        "faqs_4": {
          "type": "faqs",
          "settings": {
            "title": "Do you offer international shipping?",
            "answer": "<p>Yes, Teevore ships worldwide. Shipping rates and delivery times vary based on your location.</p>",
            "open": false
          }
        },
        "faqs_5": {
          "type": "faqs",
          "settings": {
            "title": "Can I return or exchange my T-shirt?",
            "answer": "<p>Yes, we offer a 7-day return and exchange policy on unused items with original packaging and tags.</p>",
            "open": false
          }
        },
        "faqs_6": {
          "type": "faqs",
          "settings": {
            "title": "How long does delivery take?",
            "answer": "<p>Orders are typically delivered within 3-7 business days in India, and 7-15 business days internationally.</p>",
            "open": false
